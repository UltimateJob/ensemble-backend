[{"id":"m_d549a12ab20ad250","conversationId":"c_3b92b62cc91f9b1e","role":"user","content":"最近老是睡不好，躺下就胡思乱想","tokensIn":0,"tokensOut":0,"latencyMs":0,"createdAt":"2026-10-21T21:38:12.845938+08:00"},{"id":"m_496f8c530bb8634e","conversationId":"c_3b92b62cc91f9b1e","role":"assistant","agent":"陈默","content":"嗯，躺下那会儿脑子最不听话。是最近有什么事压着，还是就单纯睡不着？","tokensIn":0,"tokensOut":22,"latencyMs":787,"createdAt":"2026-10-21T21:38:13.633496+08:00"},{"id":"m_b20f45fe9f1f4139","conversationId":"c_3b92b62cc91f9b1e","role":"assistant","agent":"小周","content":"欸我跟你讲，我以前也这样，脑子一沾枕头就开始翻旧账，越想越清醒。你试试睡前找点破事儿干，比如把明天穿啥摆好，脑子有个交代，好像就消停点了。","tokensIn":0,"tokensOut":50,"latencyMs":885,"createdAt":"2026-10-21T21:38:14.51864+08:00"},{"id":"m_1bcb53bb1c5d375b","conversationId":"c_3b92b62cc91f9b1e","role":"assistant","agent":"大罗","content":"小周这话在理，我以前也靠这土办法,睡前把第二天要办的事拿张纸写下来，脑子就跟卸了货似的，人就松了。","tokensIn":0,"tokensOut":36,"latencyMs":1008,"createdAt":"2026-10-21T21:38:15.527126+08:00"},{"id":"m_28bdf1f4aacbcb55","conversationId":"c_3b92b62cc91f9b1e","role":"user","content":"就是明天要交的方案还没写完","tokensIn":0,"tokensOut":0,"latencyMs":0,"createdAt":"2026-10-21T21:38:15.568783+08:00"},{"id":"m_0dd491aafac9e0e0","conversationId":"c_3b92b62cc91f9b1e","role":"assistant","agent":"陈默","content":"那怪不得，事儿没落地，脑子肯定不肯关机。方案卡在哪块了，是还没动手，还是写完觉得不对劲？","tokensIn":0,"tokensOut":27,"latencyMs":776,"createdAt":"2026-10-21T21:38:16.345327+08:00"},{"id":"m_b2deca37f0606a39","conversationId":"c_3b92b62cc91f9b1e","role":"assistant","agent":"大罗","content":"那就先别硬躺了，起来写两笔，哪怕把明天要动的第一段先搭个架子，心里有底了再躺。熬着翻来覆去，明早更没精神。","tokensIn":0,"tokensOut":47,"latencyMs":960,"createdAt":"2026-10-21T21:38:17.305835+08:00"}]