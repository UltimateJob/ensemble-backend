# 服务
ADDR=:8080
ADMIN_TOKEN=admin-dev-token
JWT_SECRET=change-me-in-production

# 上游模型（留空则自动使用 mock，可离线演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容中转池（可选）：名字|地址|Key|默认模型(可省)，多个逗号分隔。
# 注册后到管理台「模型」里按名字建模型、调权重，即成请求池。
# 例：EXTRA_PROVIDERS=relay-a|https://a.example.com|sk-xxx|deepseek-chat,relay-b|https://b.example.com|sk-yyy
EXTRA_PROVIDERS=
# 角色润色是否调用 DeepSeek Search API（同一个 Key）
DEEPSEEK_SEARCH=true

# 限流与容错
RATE_PER_MINUTE=240
RATE_BURST=30
MAX_RETRIES=2
BREAKER_ERRORS=5
BREAKER_OPEN=20s
UPSTREAM_TIMEOUT=120s

# 编排
DEFAULT_QUOTA=800

# 数据目录
DATA_DIR=data

# 验证码通道：log = 写日志并回显（本地/CI）；aliyun / tencent = 真实短信
SMS_PROVIDER=log
SMS_SIGN=
SMS_TEMPLATE=
SMS_KEY_ID=
SMS_SECRET=

# 演示账号（13800000000 / linmo@studio.com）免验证码。生产必须设为 false
DEV_BYPASS=true

# 超时
READ_TIMEOUT=15s
WRITE_TIMEOUT=5m
IDLE_TIMEOUT=120s
SHUTDOWN_GRACE=20s
