# 服务
ADDR=:8080
ADMIN_TOKEN=admin-dev-token
JWT_SECRET=change-me-in-production

# 上游模型（留空则自动使用 mock，可离线演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 限流与容错
RATE_PER_MINUTE=120
RATE_BURST=30
MAX_RETRIES=2
BREAKER_ERRORS=5
BREAKER_OPEN=20s
UPSTREAM_TIMEOUT=120s

# 数据目录
DATA_DIR=data

# 超时
READ_TIMEOUT=15s
WRITE_TIMEOUT=5m
IDLE_TIMEOUT=120s
SHUTDOWN_GRACE=20s
