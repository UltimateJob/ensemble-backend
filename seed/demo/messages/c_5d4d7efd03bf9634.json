[{"id":"m_e9de599f3968feff","conversationId":"c_5d4d7efd03bf9634","role":"user","content":"最近老是睡不好，躺下就胡思乱想","tokensIn":0,"tokensOut":0,"latencyMs":0,"createdAt":"2026-10-21T22:22:57.76309+08:00"},{"id":"m_f2a4c4850641d0d2","conversationId":"c_5d4d7efd03bf9634","role":"assistant","agent":"周","content":"哎我也这样过！躺床上脑子跟开会似的。要不哪天晚上出来吃个宵夜，吃完溜达一圈回去立马就困了！","tokensIn":0,"tokensOut":31,"latencyMs":885,"createdAt":"2026-10-21T22:22:58.648673+08:00"},{"id":"m_c1f91235feb90527","conversationId":"c_5d4d7efd03bf9634","role":"assistant","agent":"苏","content":"躺下就胡思乱想，那白天那点事是不是根本没停下来过？光靠宵夜溜达治不了这个。","tokensIn":0,"tokensOut":27,"latencyMs":1360,"createdAt":"2026-10-21T22:23:00.009125+08:00"},{"id":"m_d899bb2076741018","conversationId":"c_5d4d7efd03bf9634","role":"assistant","agent":"老罗","content":"这事儿吧，苏说的有道理，白天没消停，晚上脑子当然还在转。不过也别急着给自己上纲上线，先试试躺下前那半小时别碰手机，看看管不管用。","tokensIn":0,"tokensOut":43,"latencyMs":734,"createdAt":"2026-10-21T22:23:00.743608+08:00"},{"id":"m_12fa1a6d149e824c","conversationId":"c_5d4d7efd03bf9634","role":"user","content":"就是明天要交的方案还没写完","tokensIn":0,"tokensOut":0,"latencyMs":0,"createdAt":"2026-10-21T22:23:00.755323+08:00"},{"id":"m_70a59c00e25bedf2","conversationId":"c_5d4d7efd03bf9634","role":"assistant","agent":"周","content":"那还睡啥呀，赶紧起来把方案干完，越拖越焦虑！写完再睡踏实。","tokensIn":0,"tokensOut":25,"latencyMs":990,"createdAt":"2026-10-21T22:23:01.745752+08:00"},{"id":"m_e4445bf95d5dacb3","conversationId":"c_5d4d7efd03bf9634","role":"assistant","agent":"老罗","content":"这都几点了，爬起来写八成越写越精神。真躺不住就写个提纲，把明早第一件事定死，剩下的交给明天。","tokensIn":0,"tokensOut":33,"latencyMs":1382,"createdAt":"2026-10-21T22:23:03.128499+08:00"}]